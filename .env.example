# Copiar a .env (no se commitea) y completar los valores.
POSTGRES_DB=tpi_dao
POSTGRES_USER=tpi_dao
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# Cadena de conexión que usará el backend (host local).
DATABASE_URL=postgresql+psycopg://tpi_dao:cambiar_esta_clave@localhost:5432/tpi_dao

# Base de pruebas (opcional; por defecto, la de DATABASE_URL con sufijo _test).
# DATABASE_URL_TEST=postgresql+psycopg://tpi_dao:cambiar_esta_clave@localhost:5432/tpi_dao_test

# Seguridad: clave de firma de los JWT (mínimo 32 caracteres; la app no arranca con el ejemplo).
SECRET_KEY=cambiar_esta_clave_larga_de_al_menos_32_caracteres
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
TZ_NEGOCIO=America/Argentina/Cordoba

# desarrollo | test | produccion. El seed solo corre en desarrollo y test.
ENTORNO=desarrollo
# Contraseña de los usuarios de demostración (solo seed).
SEED_PASSWORD=cambiar_esta_clave
