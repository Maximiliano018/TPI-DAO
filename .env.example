# Copiar a .env (no se commitea) y completar los valores.
POSTGRES_DB=tpi_dao
POSTGRES_USER=tpi_dao
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_PORT=5432

# Cadena de conexión que usará el backend (host local).
DATABASE_URL=postgresql+psycopg://tpi_dao:cambiar_esta_clave@localhost:5432/tpi_dao

# Base de pruebas (opcional; por defecto, la de DATABASE_URL con sufijo _test).
# DATABASE_URL_TEST=postgresql+psycopg://tpi_dao:cambiar_esta_clave@localhost:5432/tpi_dao_test

# Seguridad: clave de firma de los JWT (mínimo 32 caracteres; la app no arranca con el ejemplo).
SECRET_KEY=cambiar_esta_clave_larga_de_al_menos_32_caracteres
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:5173
TZ_NEGOCIO=America/Argentina/Cordoba

# desarrollo | test | produccion. El seed solo corre en desarrollo y test.
ENTORNO=desarrollo
# Contraseña de los usuarios de demostración (solo seed): de 10 a 128 caracteres, con al menos una
# letra y un número.
SEED_PASSWORD=cambiar_esta_clave_1

# Demostración pública (opcional): usuarios que ven todo, pero no pueden modificar nada, separados
# por coma. El frontend muestra el acceso si se compila con VITE_DEMO_USUARIO y VITE_DEMO_CLAVE.
USUARIOS_SOLO_LECTURA=

# --- docker compose up (sistema completo en contenedores) ---
# Puertos publicados en el host (cambiarlos si están ocupados por el entorno de desarrollo).
BACKEND_PORT=8000
FRONTEND_PORT=8080
# Origen del frontend servido por nginx (CORS del backend en contenedor).
CORS_ORIGINS_DOCKER=http://localhost:8080
# 1: el backend carga los datos de demostración al arrancar (idempotente).
CARGAR_SEED=0

# Nivel del registro de la aplicación (DEBUG, INFO, WARNING). Por defecto INFO.
# LOG_LEVEL=INFO
