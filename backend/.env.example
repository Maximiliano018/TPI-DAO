# Copiar como backend/.env y completar. Todas las variables son opcionales en desarrollo.

# Base de datos (por defecto, backend/biblioteca.db)
# BIBLIOTECA_DATABASE_URL=sqlite:///./biblioteca.db

# Secreto para firmar las sesiones (JWT). Sin definir, se genera uno temporal al iniciar
# la API y las sesiones se pierden al reiniciarla. Generar uno con:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# BIBLIOTECA_JWT_SECRETO=

# Duración de la sesión en minutos (por defecto, una jornada)
# BIBLIOTECA_JWT_EXPIRA_MINUTOS=480

# Zona horaria de la red: define qué día es "hoy" para vencimientos
# BIBLIOTECA_ZONA_HORARIA=America/Argentina/Buenos_Aires
